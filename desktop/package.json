{
  "name": "workwise-desktop",
  "version": "0.25.0",
  "description": "Workwise as a Windows application: an Electron window around the app's own server",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "preinstall": "node ../scripts/require-node-22.mjs",
    "prepare-payload": "node prepare.mjs",
    "start": "electron .",
    "dist": "npm run prepare-payload && electron-builder --win --x64 --publish never",
    "verify": "node verify-package.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.workwise.calendar",
    "productName": "Workwise",
    "copyright": "Workwise",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "RubenCayuelas",
        "repo": "workwise-calendar"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "server.mjs",
      "updates.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/server",
        "to": "server"
      },
      {
        "from": "build/node.exe",
        "to": "node.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Workwise",
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": "22.x"
  }
}
